[Unit]
Description=pisentry host security agent (Top 10 attack reporting)
Documentation=https://github.com/MrGuato/pisentry
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pisentry run -config /etc/pisentry/config.json
# Reloads rules.d without a restart. A broken bundle is rejected and the
# previous rules stay active (pisentry_rules_reload_failures_total, PS00).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# Webhook URL/token live here, mode 0600, never in config.json.
EnvironmentFile=-/etc/pisentry/pisentry.env

# State (baselines, history) persists in /var/lib/pisentry.
StateDirectory=pisentry
StateDirectoryMode=0700
LogsDirectory=pisentry
LogsDirectoryMode=0700

# Runs as root because it must read /etc/shadow, other users' /proc/<pid>/fd
# and the journal. Everything else is taken away.
User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# PrivateTmp and PrivateDevices are deliberately OFF: pisentry needs to see the
# real /tmp and /dev/shm, which is exactly where droppers and miners live.

# Stay out of the way on a 2 GB Pi. The process itself stays near 12 MB;
# MemoryMax also counts the kernel's dentry/inode cache from the SUID and
# FIM walks, so it leaves room for that instead of reclaiming in a loop.
Nice=10
CPUQuota=25%
MemoryMax=256M

[Install]
WantedBy=multi-user.target
